                  "content": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>حاسبة بسيطة</title>\n  <style>\n    * { box-sizing: border-box; }\n    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #181818; font-family: Arial, sans-serif; }\n    .app { width: min(360px, 94vw); }\n    .calculator, .currency-box { padding: 20px; border-radius: 18px; background: #292929; box-shadow: 0 10px 30px rgba(0,0,0,.45); }\n    .currency-box { margin-top: 15px; }\n    h2 { margin: 0 0 15px; color: #eee; font-size: 20px; text-align: center; }\n    #display { width: 100%; height: 70px; margin-bottom: 15px; padding: 10px; border: 1px solid #3b3b3b; border-radius: 10px; background: #151515; color: #eee; font-size: 30px; text-align: left; }\n    .buttons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }\n    button { height: 60px; border: 0; border-radius: 10px; background: #3a3a3a; color: #eee; font-size: 22px; cursor: pointer; }\n    button:hover { background: #484848; }\n    .operator { background: #505050; }\n    .operator:hover { background: #5d5d5d; }\n    .clear { background: #6b2525; }\n    .clear:hover { background: #7b2c2c; }\n    .equal { background: #285b35; }\n    .equal:hover { background: #316d40; }\n    .currency-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }\n    .currency-box input, .currency-box select { width: 100%; height: 48px; border: 1px solid #444; border-radius: 10px; background: #151515; color: #eee; padding: 8px 10px; font-size: 16px; }\n    .currency-box input { text-align: right; }\n    .convert-btn { width: 100%; height: 52px; background: #3d5064; }\n    .convert-btn:hover { background: #49627a; }\n    #currencyResult { margin-top: 12px; min-height: 26px; color: #ddd; text-align: center; font-size: 18px; line-height: 1.5; }\n    #rateInfo { margin-top: 6px; color: #999; text-align: center; font-size: 12px; }\n  </style>\n</head>\n<body>\n  <div class=\"app\">\n    <div class=\"calculator\">\n      <input id=\"display\" type=\"text\" value=\"0\" readonly>\n      <div class=\"buttons\">\n        <button class=\"clear\" onclick=\"clearDisplay()\">C</button>\n        <button onclick=\"deleteLast()\">⌫</button>\n        <button class=\"operator\" onclick=\"appendValue('%')\">%</button>\n        <button class=\"operator\" onclick=\"appendValue('/')\">÷</button>\n        <button class=\"operator\" onclick=\"squareRoot()\">√</button>\n        <button onclick=\"appendValue('7')\">7</button>\n        <button onclick=\"appendValue('8')\">8</button>\n        <button onclick=\"appendValue('9')\">9</button>\n        <button class=\"operator\" onclick=\"appendValue('*')\">×</button>\n        <button onclick=\"appendValue('4')\">4</button>\n        <button onclick=\"appendValue('5')\">5</button>\n        <button onclick=\"appendValue('6')\">6</button>\n        <button class=\"operator\" onclick=\"appendValue('-')\">−</button>\n        <button onclick=\"appendValue('1')\">1</button>\n        <button onclick=\"appendValue('2')\">2</button>\n        <button onclick=\"appendValue('3')\">3</button>\n        <button class=\"operator\" onclick=\"appendValue('+')\">+</button>\n        <button onclick=\"appendValue('0')\" style=\"grid-column: span 2;\">0</button>\n        <button onclick=\"appendValue('.')\">.</button>\n        <button class=\"equal\" onclick=\"calculate()\">=</button>\n      </div>\n    </div>\n\n    <div class=\"currency-box\">\n      <h2>تحويل العملات</h2>\n      <div class=\"currency-row\">\n        <input id=\"currencyAmount\" type=\"number\" step=\"any\" min=\"0\" value=\"1\" placeholder=\"المبلغ\" aria-label=\"المبلغ\">\n        <select id=\"fromCurrency\" aria-label=\"العملة الأصلية\">\n          <option value=\"IQD\">دينار عراقي (IQD)</option>\n          <option value=\"USD\" selected>دولار أمريكي (USD)</option>\n          <option value=\"EUR\">يورو (EUR)</option>\n          <option value=\"GBP\">جنيه إسترليني (GBP)</option>\n          <option value=\"SAR\">ريال سعودي (SAR)</option>\n          <option value=\"AED\">درهم إماراتي (AED)</option>\n          <option value=\"TRY\">ليرة تركية (TRY)</option>\n          <option value=\"JPY\">ين ياباني (JPY)</option>\n          <option value=\"CAD\">دولار كندي (CAD)</option>\n          <option value=\"AUD\">دولار أسترالي (AUD)</option>\n        </select>\n      </div>\n      <div class=\"currency-row\">\n        <select id=\"toCurrency\" aria-label=\"العملة المستهدفة\">\n          <option value=\"IQD\" selected>دينار عراقي (IQD)</option>\n          <option value=\"USD\">دولار أمريكي (USD)</option>\n          <option value=\"EUR\">يورو (EUR)</option>\n          <option value=\"GBP\">جنيه إسترليني (GBP)</option>\n          <option value=\"SAR\">ريال سعودي (SAR)</option>\n          <option value=\"AED\">درهم إماراتي (AED)</option>\n          <option value=\"TRY\">ليرة تركية (TRY)</option>\n          <option value=\"JPY\">ين ياباني (JPY)</option>\n          <option value=\"CAD\">دولار كندي (CAD)</option>\n          <option value=\"AUD\">دولار أسترالي (AUD)</option>\n        </select>\n        <button class=\"convert-btn\" onclick=\"convertCurrency()\">تحويل</button>\n      </div>\n      <div id=\"currencyResult\">أدخل المبلغ ثم اضغط تحويل</div>\n      <div id=\"rateInfo\"></div>\n    </div>\n  </div>\n\n  <script>\n    const display = document.getElementById('display');\n\n    function appendValue(value) {\n      if (display.value === '0' && /[0-9.]/.test(value)) display.value = value;\n      else display.value += value;\n    }\n\n    function clearDisplay() { display.value = '0'; }\n\n    function deleteLast() {\n      display.value = display.value.length > 1 ? display.value.slice(0, -1) : '0';\n    }\n\n    function calculate() {\n      try {\n        const expression = display.value.replace(/%/g, '/100');\n        const result = Function('\"use strict\"; return (' + expression + ')')();\n        display.value = Number.isFinite(result) ? result : 'خطأ';\n      } catch { display.value = 'خطأ'; }\n    }\n\n    function squareRoot() {\n      try {\n        const number = Number(display.value);\n        if (Number.isNaN(number) || number < 0) {\n          display.value = 'خطأ';\n          return;\n        }\n        display.value = Math.sqrt(number);\n      } catch {\n        display.value = 'خطأ';\n      }\n    }\n\n    async function convertCurrency() {\n      const amount = Number(document.getElementById('currencyAmount').value);\n      const from = document.getElementById('fromCurrency').value;\n      const to = document.getElementById('toCurrency').value;\n      const resultEl = document.getElementById('currencyResult');\n      const rateEl = document.getElementById('rateInfo');\n\n      if (!Number.isFinite(amount) || amount < 0) {\n        resultEl.textContent = 'أدخل مبلغًا صحيحًا';\n        rateEl.textContent = '';\n        return;\n      }\n\n      if (from === to) {\n        resultEl.textContent = `${formatNumber(amount)} ${from} = ${formatNumber(amount)} ${to}`;\n        rateEl.textContent = 'سعر التحويل: 1';\n        return;\n      }\n\n      resultEl.textContent = 'جاري جلب سعر الصرف...';\n      rateEl.textContent = '';\n\n      try {\n        const response = await fetch(`https://api.frankfurter.app/latest?amount=${encodeURIComponent(amount)}&from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`);\n        if (!response.ok) throw new Error('تعذر جلب سعر الصرف');\n        const data = await response.json();\n        const converted = data.rates && data.rates[to];\n        if (!Number.isFinite(converted)) throw new Error('العملة غير مدعومة');\n\n        const rate = converted / amount;\n        resultEl.textContent = `${formatNumber(amount)} ${from} = ${formatNumber(converted)} ${to}`;\n        rateEl.textContent = `سعر التحويل: 1 ${from} = ${formatNumber(rate)} ${to} • المصدر: Frankfurter`;\n      } catch (error) {\n        resultEl.textContent = 'تعذر جلب سعر الصرف. تحقق من اتصال الإنترنت.';\n        rateEl.textContent = '';\n      }\n    }\n\n    function formatNumber(value) {\n      return new Intl.NumberFormat('en-US', { maximumFractionDigits: 6 }).format(value);\n    }\n\n    // لوحة المفاتيح تخص الحاسبة الرئيسية فقط.\n    // عندما يكون المؤشر داخل تحويل العملات، تبقى الأرقام داخل حقل المبلغ ولا تصل للحاسبة الرئيسية.\n    document.addEventListener('keydown', (event) => {\n      if (event.target.closest('.currency-box')) {\n        if (event.target.id === 'currencyAmount' && event.key === 'Enter') {\n          convertCurrency();\n          event.preventDefault();\n        }\n        return;\n      }\n\n      const key = event.key;\n\n      if (/^[0-9.]$/.test(key)) {\n        appendValue(key);\n        event.preventDefault();\n        return;\n      }\n\n      if (['+', '-', '*', '/', '%'].includes(key)) {\n        appendValue(key);\n        event.preventDefault();\n        return;\n      }\n\n      if (key === 'Enter' || key === '=') {\n        calculate();\n        event.preventDefault();\n        return;\n      }\n\n      if (key === 'Backspace') {\n        deleteLast();\n        event.preventDefault();\n        return;\n      }\n\n      if (key === 'Escape' || key.toLowerCase() === 'c') {\n        clearDisplay();\n        event.preventDefault();\n        return;\n      }\n\n      if (key.toLowerCase() === 'r') {\n        squareRoot();\n        event.preventDefault();\n      }\n    });\n  </script>\n</body>\n</html>\n"
                }
              }
            }
