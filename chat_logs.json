                  "content": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>الحاسبة الذكية | VSA Academy</title>\n    <style>\n        :root {\n            --bg-color: #0f172a;\n            --card-bg: #1e293b;\n            --text-color: #f8fafc;\n            --accent-color: #38bdf8;\n            --accent-hover: #0ea5e9;\n            --btn-bg: #334155;\n            --btn-hover: #475569;\n            --op-bg: #0284c7;\n            --op-hover: #0369a1;\n            --clear-bg: #ef4444;\n            --clear-hover: #dc2626;\n        }\n\n        body {\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            height: 100vh;\n            margin: 0;\n        }\n\n        .calculator {\n            background-color: var(--card-bg);\n            padding: 24px;\n            border-radius: 16px;\n            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);\n            width: 320px;\n            box-sizing: border-box;\n        }\n\n        .calculator-header {\n            text-align: center;\n            margin-bottom: 16px;\n            font-size: 1.1rem;\n            font-weight: bold;\n            color: var(--accent-color);\n        }\n\n        .display {\n            background-color: #090d16;\n            color: #38bdf8;\n            font-size: 2rem;\n            padding: 16px;\n            border-radius: 8px;\n            text-align: left;\n            margin-bottom: 20px;\n            word-wrap: break-word;\n            word-break: break-all;\n            min-height: 50px;\n            box-sizing: border-box;\n            direction: ltr;\n        }\n\n        .buttons {\n            display: grid;\n            grid-template-columns: repeat(4, 1fr);\n            gap: 10px;\n        }\n\n        button {\n            background-color: var(--btn-bg);\n            color: var(--text-color);\n            border: none;\n            padding: 16px;\n            font-size: 1.2rem;\n            border-radius: 8px;\n            cursor: pointer;\n            transition: background-color 0.2s, transform 0.1s;\n        }\n\n        button:hover {\n            background-color: var(--btn-hover);\n        }\n\n        button:active {\n            transform: scale(0.95);\n        }\n\n        .operator {\n            background-color: var(--op-bg);\n        }\n\n        .operator:hover {\n            background-color: var(--op-hover);\n        }\n\n        .clear {\n            background-color: var(--clear-bg);\n        }\n\n        .clear:hover {\n            background-color: var(--clear-hover);\n        }\n\n        .span-2 {\n            grid-column: span 2;\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"calculator\">\n        <div class=\"calculator-header\">الحاسبة الذكية (VSA)</div>\n        <div id=\"display\" class=\"display\">0</div>\n        <div class=\"buttons\">\n            <button class=\"clear\" onclick=\"clearDisplay()\">C</button>\n            <button onclick=\"appendValue('(')\">(</button>\n            <button onclick=\"appendValue(')')\">)</button>\n            <button class=\"operator\" onclick=\"appendValue('/')\">÷</button>\n            \n            <button onclick=\"appendValue('7')\">7</button>\n            <button onclick=\"appendValue('8')\">8</button>\n            <button onclick=\"appendValue('9')\">9</button>\n            <button class=\"operator\" onclick=\"appendValue('*')\">×</button>\n            \n            <button onclick=\"appendValue('4')\">4</button>\n            <button onclick=\"appendValue('5')\">5</button>\n            <button onclick=\"appendValue('6')\">6</button>\n            <button class=\"operator\" onclick=\"appendValue('-')\">-</button>\n            \n            <button onclick=\"appendValue('1')\">1</button>\n            <button onclick=\"appendValue('2')\">2</button>\n            <button onclick=\"appendValue('3')\">3</button>\n            <button class=\"operator\" onclick=\"appendValue('+')\">+</button>\n            \n            <button onclick=\"appendValue('0')\" class=\"span-2\">0</button>\n            <button onclick=\"appendValue('.')\">.</button>\n            <button class=\"operator\" onclick=\"calculate()\">=</button>\n        </div>\n    </div>\n\n    <script>\n        const display = document.getElementById('display');\n        let currentInput = '0';\n\n        function updateDisplay() {\n            display.textContent = currentInput;\n        }\n\n        function appendValue(value) {\n            if (currentInput === '0' && value !== '.') {\n                currentInput = value;\n            } else {\n                currentInput += value;\n            }\n            updateDisplay();\n        }\n\n        function clearDisplay() {\n            currentInput = '0';\n            updateDisplay();\n        }\n\n        function calculate() {\n            try {\n                // استبدال الرموز المرئية برموز البرمجة\n                let expression = currentInput.replace(/×/g, '*').replace(/÷/g, '/');\n                let result = eval(expression);\n                currentInput = String(result);\n                updateDisplay();\n            } catch (error) {\n                currentInput = 'خطأ';\n                updateDisplay();\n                setTimeout(clearDisplay, 1500);\n            }\n        }\n    </script>\n</body>\n</html>\n"
