[Unit]
Description=Mastermind External Docker Runtime Executor
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mastermind-runtime/cloud_runtime_executor
EnvironmentFile=/etc/mastermind-runtime/runtime.env
ExecStart=/usr/bin/node /opt/mastermind-runtime/cloud_runtime_executor/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mastermind-runtime

[Install]
WantedBy=multi-user.target
